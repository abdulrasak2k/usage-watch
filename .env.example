# Cloudflare R2 analytics
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_API_TOKEN=

# MongoDB Atlas Administration API OAuth service account
MONGODB_ATLAS_PROJECT_ID=
MONGODB_ATLAS_CLIENT_ID=
MONGODB_ATLAS_CLIENT_SECRET=
# Optional when the project has one cluster
MONGODB_ATLAS_PROCESS_ID=

# Upstash Developer API
UPSTASH_DATABASE_ID=
UPSTASH_EMAIL=
UPSTASH_API_KEY=

# Vercel billing usage (server-only access token)
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Supabase Management API (not the anon or service-role key)
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=

# Resend usage collection requires a Full-access key. Keep the application's
# Sending-access key separate and use it only for sending email.
RESEND_USAGE_API_KEY=
